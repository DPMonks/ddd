# Absolute base URL of the deployed site.
# Used for metadataBase, canonical tags, sitemap.xml, robots.txt, and OpenGraph.
# Defaults to https://design.dpmf.technology when unset (see src/lib/site.js).
#
# Local development:   NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production:          NEXT_PUBLIC_SITE_URL=https://design.dpmf.technology
NEXT_PUBLIC_SITE_URL=https://design.dpmf.technology
